  <!-- ═══════════════════════════════════════════════════════════════════════════
       CHECKLIST_RESPONSES  (no handler; checklistRunner.ts matches them by spoken text)
  ════════════════════════════════════════════════════════════════════════════ -->
  <rule id="CHECKLIST_RESPONSES">
    <one-of>
      <item>set and checked<tag>out.pid="set_and_checked";</tag></item>
      <item>chocks in place<tag>out.pid="chocks_in_place";</tag></item>
