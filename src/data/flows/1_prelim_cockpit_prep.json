{
  "id": "prelim_cockpit_prep",
  "name": "Preliminary Cockpit Preparation",
  "steps": [
    {
      "label": "Set Chocks",
      "read": "(L:INI_CHOCKS_ENABLED)",
      "on": "1 (>L:INI_CHOCKS_ENABLED)",
      "expect": 1
    },
    {
      "label": "Battery 1 Check",
      "read": "(L:INI_elec_ind_dc_selector)",
      "on": "0 (>L:INI_elec_ind_dc_selector)",
      "expect": 0,
      "wait_ms": 5000
    },
    {
      "label": "Battery 2 Check",
      "read": "(L:INI_elec_ind_dc_selector)",
      "on": "1 (>L:INI_elec_ind_dc_selector)",
      "expect": 1,
      "wait_ms": 5000
    },
    {
      "label": "Battery 3 Check",
      "read": "(L:INI_elec_ind_dc_selector)",
      "on": "2 (>L:INI_elec_ind_dc_selector)",
      "expect": 2,
      "wait_ms": 5000
    },
    {
      "label": "Battery 1 On",
      "read": "(L:INI_BAT1_ON)",
      "on": "1 (>L:INI_BAT1_ON)",
      "expect": 1
    },
    {
      "label": "Battery 2 On",
      "read": "(L:INI_BAT2_ON)",
      "on": "1 (>L:INI_BAT2_ON)",
      "expect": 1
    },
    {
      "label": "Battery 3 On",
      "read": "(L:INI_BAT3_ON)",
      "on": "1 (>L:INI_BAT3_ON)",
      "expect": 1
    },
    {
      "label": "APU Fire Test",
      "read": "(L:INI_APU_LOOP_TEST_SWITCH)",
      "on": "1 (>L:INI_APU_LOOP_TEST_SWITCH)",
      "sound_on_execute": "fire_test.ogg",
      "expect": 1,
      "hold_ms": 10000
    },
    {
      "label": "External power on",
      "read": "(L:INI_ext_power_available)",
      "on": "1 (>K:TOGGLE_EXTERNAL_POWER)",
      "expect": 1,
      "wait_ms": 6000
    },
    {
      "label": "Dome on",
      "read": "(L:INI_DOME_LIGHT_SWITCH)",
      "on": "1 (>L:INI_DOME_LIGHT_SWITCH)",
      "only_if": {
        "read": "(E:TIME OF DAY)",
        "one_of": [0, 2, 3]
      }
    },
    {
      "label": "Cockpit lights on",
      "read": "(L:INI_POTENTIOMETER_27)",
      "on": "85 (>L:INI_POTENTIOMETER_27)",
      "expect": 85,
      "only_if": {
        "read": "(E:TIME OF DAY)",
        "one_of": [0, 2, 3]
      }
    },
    {
      "label": "Cockpit lights on",
      "read": "(L:INI_POTENTIOMETER_4)",
      "on": "85 (>L:INI_POTENTIOMETER_4)",
      "expect": 85,
      "only_if": {
        "read": "(E:TIME OF DAY)",
        "one_of": [0, 2, 3]
      }
    },
    {
      "label": "Cockpit lights on",
      "read": "(L:INI_POTENTIOMETER_3)",
      "on": "85 (>L:INI_POTENTIOMETER_3)",
      "expect": 85,
      "only_if": {
        "read": "(E:TIME OF DAY)",
        "one_of": [0, 2, 3]
      }
    },
    {
      "label": "Fuel pump on",
      "read": "(L:INI_INNER_TANK2_LEFT)",
      "on": "1 (>L:INI_INNER_TANK2_LEFT)",
      "expect": 1
    },
    {
      "label": "Announcer lights test",
      "read": "(L:INI_ANNLT_SWITCH)",
      "on": "0 (>L:INI_ANNLT_SWITCH)",
      "expect": 0,
      "hold_ms": 10000
    },
    {
      "label": "Announcer lights test",
      "read": "(L:INI_ANNLT_SWITCH)",
      "on": "1 (>L:INI_ANNLT_SWITCH)",
      "expect": 1
    },
    {
      "label": "Parking brake set",
      "read": "(A:BRAKE PARKING INDICATOR, Bool)",
      "on": "1 (>K:PARKING_BRAKE_SET)",
      "expect": 1
    }
  ]
}
