{
  "id": "desc_ten_thousand_flow",
  "name": "Descend Ten Thousand Flow",
  "steps": [
    {
      "label": "Engine 1 Anti Ice",
      "read": "(L:INI_ENG1_ANTI_ICE)",
      "on": "{anti_ice_eng1_ldg_cmd}",
      "expect": "{anti_ice_eng1_ldg_expect}",
      "skip_delay": true
    },
    {
      "label": "Engine 2 Anti Ice",
      "read": "(L:INI_ENG2_ANTI_ICE)",
      "on": "{anti_ice_eng2_ldg_cmd}",
      "expect": "{anti_ice_eng2_ldg_expect}"
    },
    {
      "label": "Wing Anti Ice",
      "read": "(L:INI_WING_ANTI_ICE)",
      "on": "{anti_ice_wing_ldg_cmd}",
      "expect": "{anti_ice_wing_ldg_expect}"
    },
    {
      "label": "Ignition set",
      "read": "(L:INI_eng_ignition_switch)",
      "on": "4 (>L:INI_eng_ignition_switch)",
      "expect": 4
    },
    {
      "label": "Seat belts",
      "read": "(L:INI_SEATBELTS_SWITCH)",
      "on": "1 (>L:INI_SEATBELTS_SWITCH)",
      "expect": 1
    },
    {
      "label": "Landing Lights",
      "read": "(L:INI_LANDING_LIGHT_L_SWITCH)",
      "on": "0 (>L:INI_LANDING_LIGHT_L_SWITCH)",
      "expect": 0,
      "skip_delay": true
    },
    {
      "label": "Landing Lights",
      "read": "(L:INI_LANDING_LIGHT_R_SWITCH)",
      "on": "0 (>L:INI_LANDING_LIGHT_R_SWITCH)",
      "expect": 0
    },
    {
      "label": "ND SET",
      "read": "(L:INI_map_range_fo_switch)",
      "on": "0 (>L:INI_map_range_fo_switch)",
      "expect": 0
    },
    {
      "label": "NAV mode select",
      "read": "(L:INI_EFIS_SELECTED_NAV_FO)",
      "on": "{appr_nav_mode_on}",
      "expect": "{appr_nav_mode_expect}"
    }
  ]
}
