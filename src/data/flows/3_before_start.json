{
  "id": "before_start",
  "name": "Before Start",
  "steps": [
    {
      "label": "Close Cockpit door",
      "read": "(L:INI_COCKPIT_DOOR_OPEN)",
      "on": "0 (>L:INI_COCKPIT_DOOR_STATE)",
      "expect": 0
    },
    {
      "label": "SET MCDU",
      "read": "(L:INI_MCDU2_FPLAN)",
      "on": "1 (>L:INI_MCDU2_FPLAN)",
      "expect": 1
    },
    {
      "label": "Beacon on",
      "read": "(L:INI_BEACON_LIGHT_SWITCH)",
      "on": "1 (>L:INI_BEACON_LIGHT_SWITCH)",
      "expect": 1
    },
    {
      "label": "TCAS Set",
      "read": "(L:INI_tcas_mode_pedestal)",
      "on": "1 (>L:INI_tcas_mode_pedestal)",
      "expect": 1,
      "only_if": {
        "read": "(L:INI_IS_IDC)",
        "one_of": [0]
      }
    },
    {
      "label": "TCAS Set",
      "read": "(L:IDC_TUN_FO)",
      "on": "1 (>L:IDC_TUN_FO)",
      "expect": 1,
      "only_if": {
        "read": "(L:INI_IS_IDC)",
        "one_of": [1]
      }
    },
    {
      "label": "TCAS Set",
      "read": "(L:INI_tcas_mode_pedestal)",
      "on": "1 (>L:IDC_RSK5_FO)",
      "expect": 2,
      "only_if": {
        "read": "(L:INI_IS_IDC)",
        "one_of": [1]
      }
    },
    {
      "label": "Remove Chocks",
      "read": "(L:INI_CHOCKS_ENABLED)",
      "on": "0 (>L:INI_CHOCKS_ENABLED)",
      "expect": 0
    }
  ]
}
