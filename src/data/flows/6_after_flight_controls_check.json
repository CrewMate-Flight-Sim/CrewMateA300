{
  "id": "after_flight_controls_check",
  "name": "Taxi",
  "steps": [
    {
      "label": "Close FCTL ECAM",
      "read": "(L:PUSH_ECAM_FCTL)",
      "on": "1 (>L:PUSH_ECAM_FCTL)",
      "expect": 1
    },
    {
      "label": "Arm profile mode",
      "read": "(L:AP3_BUTTON)",
      "on": "1 (>L:AP3_BUTTON)",
      "expect": 1
    },
    {
      "label": "Arm nav mode",
      "read": "(L:INI_FCU_MANAGED_HEADING_BUTTON)",
      "on": "1 (>L:INI_FCU_MANAGED_HEADING_BUTTON)",
      "expect": 1,
      "skip_verify": true,
      "sound_after_execute": "nav_prof_armed.ogg"
    },
    {
      "label": "Weather radar on",
      "read": "(L:INI_WXR_SYS)",
      "on": "2 (>L:INI_WXR_SYS)",
      "expect": 2
    },
    {
      "label": "Takeoff config test",
      "read": "(L:INI_TAKEOFF_CONFIG_PRESSED)",
      "on": "1 (>L:INI_TAKEOFF_CONFIG_PRESSED)",
      "expect": 1,
      "hold_ms": 2000
    }
  ]
}
