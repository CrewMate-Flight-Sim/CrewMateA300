{
  "id": "shutdown",
  "name": "Shutdown",
  "steps": [
    {
      "label": "Engine 1 Anti Ice",
      "read": "(L:INI_ENG_ANTI_ICE1)",
      "on": "0 (>L:INI_ENG_ANTI_ICE1)",
      "expect": 0,
      "skip_delay": true
    },
    {
      "label": "Engine 2 Anti Ice",
      "read": "(L:INI_ENG_ANTI_ICE2)",
      "on": "0 (>L:INI_ENG_ANTI_ICE2)",
      "expect": 0
    },
    {
      "label": "APU Bleed",
      "read": "(L:INI_apu_bleed)",
      "on": "1 (>L:INI_apu_bleed)",
      "expect": 1
    },
    {
      "label": "Elapsed time stop",
      "read": "(L:INI_ET_TOGGLE_BUTTON_FO)",
      "on": "1 (>L:INI_ET_TOGGLE_BUTTON_FO)",
      "expect": 1
    },
    {
      "label": "Fuel pumps off",
      "read": "(L:INI_OUTER_TANK1_LEFT)",
      "on": "0 (>L:INI_OUTER_TANK1_LEFT)",
      "expect": 0,
      "skip_delay": true
    },
    {
      "label": "Fuel pumps off",
      "read": "(L:INI_OUTER_TANK2_LEFT)",
      "on": "0 (>L:INI_OUTER_TANK2_LEFT)",
      "expect": 0
    },
    {
      "label": "Fuel pumps off",
      "read": "(L:INI_OUTER_TANK1_RIGHT)",
      "on": "0 (>L:INI_OUTER_TANK1_RIGHT)",
      "expect": 0,
      "skip_delay": true
    },
    {
      "label": "Fuel pumps off",
      "read": "(L:INI_OUTER_TANK2_RIGHT)",
      "on": "0 (>L:INI_OUTER_TANK2_RIGHT)",
      "expect": 0
    },
    {
      "label": "Fuel pumps off",
      "read": "(L:INI_INNER_TANK1_LEFT)",
      "on": "0 (>L:INI_INNER_TANK1_LEFT)",
      "expect": 0
    },
    {
      "label": "Fuel pumps off",
      "read": "(L:INI_INNER_TANK1_RIGHT)",
      "on": "0 (>L:INI_INNER_TANK1_RIGHT)",
      "expect": 0,
      "skip_delay": true
    },
    {
      "label": "Fuel pumps off",
      "read": "(L:INI_INNER_TANK2_RIGHT)",
      "on": "0 (>L:INI_INNER_TANK2_RIGHT)",
      "expect": 0
    },
    {
      "label": "Fuel pumps off",
      "read": "(L:INI_CENTER_TANK1)",
      "on": "0 (>L:INI_CENTER_TANK1)",
      "expect": 0,
      "skip_delay": true
    },
    {
      "label": "Fuel pumps off",
      "read": "(L:INI_CENTER_TANK2)",
      "on": "0 (>L:INI_CENTER_TANK2)",
      "expect": 0
    },
    {
      "label": "Fuel pumps off",
      "read": "(L:INI_TRIM_TANK1)",
      "on": "0 (>L:INI_TRIM_TANK1)",
      "expect": 0,
      "skip_delay": true
    },
    {
      "label": "Fuel pumps off",
      "read": "(L:INI_TRIM_TANK2)",
      "on": "0 (>L:INI_TRIM_TANK2)",
      "expect": 0
    },
    {
      "label": "Window heat off",
      "read": "(L:INI_WINDOW_HEAT1)",
      "on": "0 (>L:INI_WINDOW_HEAT1)",
      "expect": 0
    },
    {
      "label": "Window heat off",
      "read": "(L:INI_WINDOW_HEAT2)",
      "on": "0 (>L:INI_WINDOW_HEAT2)",
      "expect": 0
    },
    {
      "label": "Probe heat off",
      "read": "(L:INI_PROBE_HEAT_CAPT)",
      "on": "0 (>L:INI_PROBE_HEAT_CAPT)",
      "expect": 0
    },
    {
      "label": "Probe heat off",
      "read": "(L:INI_PROBE_HEAT_COPILOT)",
      "on": "0 (>L:INI_PROBE_HEAT_COPILOT)",
      "expect": 0
    },
    {
      "label": "Probe heat off",
      "read": "(L:INI_PROBE_HEAT_STANDBY)",
      "on": "0 (>L:INI_PROBE_HEAT_STANDBY)",
      "expect": 0
    },
    {
      "label": "TCAS Set",
      "read": "(L:INI_tcas_mode_pedestal)",
      "on": "0 (>L:INI_tcas_mode_pedestal)",
      "expect": 0
    },
    {
      "label": "Set Chocks",
      "read": "(L:INI_CHOCKS_ENABLED)",
      "on": "1 (>L:INI_CHOCKS_ENABLED)",
      "expect": 1
    }
  ]
}
