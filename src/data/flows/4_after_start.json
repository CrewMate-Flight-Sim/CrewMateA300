{
  "id": "after_start",
  "name": "After Start",
  "steps": [
    {
      "label": "APU Bleed off",
      "read": "(L:INI_apu_bleed)",
      "on": "0 (>L:INI_apu_bleed)",
      "expect": 0
    },
    {
      "label": "APU",
      "read": "(L:INI_apu_master_switch)",
      "on": "{apu_cmd}",
      "expect": "{apu_expect}"
    },
    {
      "label": "Engine 1 Anti Ice",
      "read": "(L:INI_ENG1_ANTI_ICE)",
      "on": "{anti_ice_eng1_to_cmd}",
      "expect": "{anti_ice_eng1_to_expect}",
      "skip_delay": true
    },
    {
      "label": "Engine 2 Anti Ice",
      "read": "(L:INI_ENG2_ANTI_ICE)",
      "on": "{anti_ice_eng2_to_cmd}",
      "expect": "{anti_ice_eng2_to_expect}"
    },
    {
      "label": "Wing Anti Ice",
      "read": "(L:INI_WING_ANTI_ICE)",
      "on": "{anti_ice_wing_to_cmd}",
      "expect": "{anti_ice_wing_to_expect}"
    },
    {
      "label": "Flaps",
      "read": "(A:FLAPS HANDLE INDEX,Number)",
      "on": "(>K:FLAPS_{flaps})",
      "expect": "{flaps}",
      "flaps_lever": true,
      "only_if": {
        "option": "takeoff.antiIce",
        "one_of": ["off"]
      }
    },
    {
      "label": "Ground Spoilers",
      "read": "(L:INI_SPOILERS_ARMED)",
      "on": "1 (>K:SPOILERS_ARM_SET)",
      "expect": 1
    },
    {
      "label": "Reset Rudder Trim",
      "read": "(L:INI_RESET_RUDDER_TRIM_COMMAND)",
      "on": "1 (>L:INI_RESET_RUDDER_TRIM_COMMAND)",
      "expect": 1,
      "skip_verify": true
    },
    {
      "label": "Reset Rudder Trim",
      "read": "(L:INI_RESET_RUDDER_TRIM_COMMAND)",
      "on": "0 (>L:INI_RESET_RUDDER_TRIM_COMMAND)",
      "expect": 0,
      "skip_verify": true
    },
    {
      "label": "Pitch trim",
      "read": "(L:ELEV_TRIM_RATIO)",
      "on": "{pitch_trim_cmd}",
      "expect": "{pitch_trim_expect}",
      "strict_verify": true
    },
    {
      "label": "Dome off",
      "read": "(L:INI_DOME_LIGHT_SWITCH)",
      "on": "0 (>L:INI_DOME_LIGHT_SWITCH)"
    }
  ]
}
