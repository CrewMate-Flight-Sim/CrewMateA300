{
  "id": "after_landing",
  "name": "After Landing",
  "steps": [
    {
      "label": "Engine 1 Anti Ice",
      "read": "(L:INI_ENG_ANTI_ICE1)",
      "on": "{landing_anti_ice_eng1_cmd}",
      "expect": "{landing_anti_ice_eng1_expect}",
      "skip_delay": true
    },
    {
      "label": "Engine 2 Anti Ice",
      "read": "(L:INI_ENG_ANTI_ICE2)",
      "on": "{landing_anti_ice_eng2_cmd}",
      "expect": "{landing_anti_ice_eng2_expect}"
    },
    {
      "label": "Wing Anti Ice",
      "read": "(L:INI_WING_ANTI_ICE)",
      "on": "0 (L:INI_WING_ANTI_ICE)",
      "expect": 0
    },
    {
      "label": "Ignition set",
      "read": "(L:INI_eng_ignition_switch)",
      "on": "3 (>L:INI_eng_ignition_switch)",
      "expect": 3
    },
    {
      "label": "APU",
      "read": "(L:INI_apu_master_switch)",
      "on": "1 (>L:INI_apu_master_switch)",
      "expect": 1,
      "wait_ms": 2000,
      "only_if": {
        "option": "landing.apuStart",
        "one_of": ["auto"]
      }
    },
    {
      "label": "APU Start",
      "read": "(L:INI_APU_START_BUTTON)",
      "on": "1 (>L:INI_apu_start_button)",
      "expect": 1,
      "only_if": {
        "option": "landing.apuStart",
        "one_of": ["auto"]
      }
    },

    {
      "label": "Weather radar",
      "read": "(L:INI_WXR_SYS)",
      "on": "1 (>L:INI_WXR_SYS)",
      "expect": 1
    },
    {
      "label": "Pitch trim",
      "read": "(L:ELEV_TRIM_RATIO)",
      "on": "1 (>L:ELEV_TRIM_RATIO)",
      "expect": 1
    },
    {
      "label": "Flaps",
      "read": "(A:FLAPS HANDLE INDEX,Number)",
      "on": "1 (>K:FLAPS_UP)",
      "expect": 0,
      "only_if": {
        "option": "landing.antiIce",
        "one_of": ["off"]
      }
    },
    {
      "label": "Landing Lights",
      "read": "(L:INI_LANDING_LIGHT_L_SWITCH)",
      "on": "0 (>L:INI_LANDING_LIGHT_L_SWITCH)",
      "expect": 0,
      "only_if": {
        "option": "settings.lightsControlMode",
        "one_of": ["virtual"]
      }
    },
    {
      "label": "Landing Lights",
      "read": "(L:INI_LANDING_LIGHT_R_SWITCH)",
      "on": "0 (>L:INI_LANDING_LIGHT_R_SWITCH)",
      "expect": 0,
      "only_if": {
        "option": "settings.lightsControlMode",
        "one_of": ["virtual"]
      }
    },
    {
      "label": "Strobes",
      "read": "(L:INI_POTENTIOMETER_24)",
      "on": "1 (>L:INI_POTENTIOMETER_24)",
      "expect": 1,
      "only_if": {
        "option": "settings.lightsControlMode",
        "one_of": ["virtual"]
      }
    },
    {
      "label": "Nose Wheel Light",
      "read": "(L:INI_TAXI_LIGHTS_SWITCH)",
      "on": "1 (>L:INI_TAXI_LIGHTS_SWITCH)",
      "expect": 1,
      "only_if": {
        "option": "settings.lightsControlMode",
        "one_of": ["virtual"]
      }
    }
  ]
}
