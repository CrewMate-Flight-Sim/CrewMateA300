{
  "id": "landing",
  "name": "Landing Checklist",
  "items": [
    {
      "challenge": "gear.ogg",
      "response": ["down", "set and checked"],
      "label": "Landing Gear",
      "validations": [
        {
          "when": { "always": true },
          "checks": [{ "type": "simvar", "var": "(L:INI_GEAR_HANDLE_STATUS)", "expected": 2 }]
        }
      ]
    },
    {
      "challenge": "auto_brake.ogg",
      "response": ["off", "low", "mid", "max", "set and checked"],
      "label": "Autobrake",
      "validations": [
        {
          "when": { "responses": "off" },
          "checks": [
            { "type": "store", "store": "landing.autoBrake", "equals": "off" },
            { "type": "simvar", "var": "(L:INI_AUTOBRAKE_LEVEL)", "expected": 0 }
          ]
        },
        {
          "when": { "responses": "low" },
          "checks": [
            { "type": "store", "store": "landing.autoBrake", "equals": "min" },
            { "type": "simvar", "var": "(L:INI_AUTOBRAKE_LEVEL)", "expected": 1 }
          ]
        },
        {
          "when": { "responses": "mid" },
          "checks": [
            { "type": "store", "store": "landing.autoBrake", "equals": "med" },
            { "type": "simvar", "var": "(L:INI_AUTOBRAKE_LEVEL)", "expected": 2 }
          ]
        },
        {
          "when": { "responses": "max" },
          "checks": [
            { "type": "store", "store": "landing.autoBrake", "equals": "max" },
            { "type": "simvar", "var": "(L:INI_AUTOBRAKE_LEVEL)", "expected": 3 }
          ]
        },
        {
          "when": { "responses": ["set and checked"] },
          "checks": [
            {
              "type": "any",
              "groups": [
                [
                  { "type": "store", "store": "landing.autoBrake", "equals": "off" },
                  { "type": "simvar", "var": "(L:INI_AUTOBRAKE_LEVEL)", "expected": 0 }
                ],
                [
                  { "type": "store", "store": "landing.autoBrake", "equals": "min" },
                  { "type": "simvar", "var": "(L:INI_AUTOBRAKE_LEVEL)", "expected": 1 }
                ],
                [
                  { "type": "store", "store": "landing.autoBrake", "equals": "med" },
                  { "type": "simvar", "var": "(L:INI_AUTOBRAKE_LEVEL)", "expected": 2 }
                ],
                [
                  { "type": "store", "store": "landing.autoBrake", "equals": "max" },
                  { "type": "simvar", "var": "(L:INI_AUTOBRAKE_LEVEL)", "expected": 3 }
                ]
              ]
            }
          ]
        }
      ]
    },
    {
      "challenge": "askid.ogg",
      "response": ["checked", "set and checked"],
      "label": "Antiskid"
    },
    {
      "challenge": "slats_flaps.ogg",
      "response": ["twenty", "fourty", "set and checked"],
      "label": "Slats and flaps",
      "incorrect": "are_you_sure.ogg",
      "validations": [
        {
          "when": { "responses": ["twenty"] },
          "checks": [{ "type": "simvar", "var": "(L:INI_GPWS_LANDING_SWITCH)", "expected": 1 }]
        },
        {
          "when": { "responses": ["fourty"] },
          "checks": [{ "type": "simvar", "var": "(L:INI_GPWS_LANDING_SWITCH)", "expected": 0 }]
        },
        {
          "when": { "responses": ["set and checked"] }
        }
      ]
    },
    {
      "challenge": "spoilers.ogg",
      "response": ["armed", "set and checked"],
      "label": "Spoilers",
      "validations": [
        {
          "when": { "always": true },
          "checks": [{ "type": "simvar", "var": "(L:INI_SPOILERS_ARMED)", "expected": 1 }]
        }
      ]
    }
  ],
  "completion": "landing_checklist_completed.ogg"
}
