{
  "id": "parking",
  "name": "Parking Checklist",
  "items": [
    {
      "challenge": "apu_bleed.ogg",
      "response": ["off", "on", "set and checked"],
      "label": "APU bleed",
      "validations": [
        {
          "when": { "responses": ["off"] },
          "checks": [{ "type": "simvar", "var": "(L:INI_apu_bleed)", "expected": 0 }]
        },
        {
          "when": { "responses": ["on"] },
          "checks": [{ "type": "simvar", "var": "(L:INI_apu_bleed)", "expected": 1 }]
        }
      ]
    },
    {
      "challenge": "engines.ogg",
      "response": ["off", "set and checked"],
      "label": "Engines",
      "validations": [
        {
          "when": { "always": true },
          "checks": [
            { "type": "simvar", "var": "(L:INI_MIXTURE_RATIO1_HANDLE)", "expected": 0 },
            { "type": "simvar", "var": "(L:INI_MIXTURE_RATIO2_HANDLE)", "expected": 0 }
          ]
        }
      ]
    },
    {
      "challenge": "diff_p.ogg",
      "response": ["check zero", "set and checked"],
      "label": "Differential pressure"
    },
    {
      "challenge": "light_sign.ogg",
      "response": ["set", "set and checked"],
      "label": "Lights and signs"
    },
    {
      "challenge": "fuel_pumps.ogg",
      "response": ["off", "set and checked"],
      "label": "Fuel pumps",
      "validations": [
        {
          "when": { "always": true },
          "checks": [
            { "type": "simvar", "var": "(L:INI_OUTER_TANK1_LEFT)", "expected": 0 },
            { "type": "simvar", "var": "(L:INI_OUTER_TANK2_LEFT)", "expected": 0 },
            { "type": "simvar", "var": "(L:INI_OUTER_TANK1_RIGHT)", "expected": 0 },
            { "type": "simvar", "var": "(L:INI_OUTER_TANK2_RIGHT)", "expected": 0 },
            { "type": "simvar", "var": "(L:INI_INNER_TANK1_LEFT)", "expected": 0 },
            { "type": "simvar", "var": "(L:INI_INNER_TANK1_RIGHT)", "expected": 0 },
            { "type": "simvar", "var": "(L:INI_INNER_TANK2_RIGHT)", "expected": 0 },
            { "type": "simvar", "var": "(L:INI_CENTER_TANK1)", "expected": 0 },
            { "type": "simvar", "var": "(L:INI_CENTER_TANK2)", "expected": 0 },
            { "type": "simvar", "var": "(L:INI_TRIM_TANK1)", "expected": 0 },
            { "type": "simvar", "var": "(L:INI_TRIM_TANK2)", "expected": 0 }
          ]
        }
      ]
    },
    {
      "challenge": "window_ph.ogg",
      "response": ["off", "set and checked"],
      "label": "Window and probe heat",
      "validations": [
        {
          "when": { "always": true },
          "checks": [
            { "type": "simvar", "var": "(L:INI_WINDOW_HEAT1)", "expected": 0 },
            { "type": "simvar", "var": "(L:INI_WINDOW_HEAT2)", "expected": 0 },
            { "type": "simvar", "var": "(L:INI_PROBE_HEAT_CAPT)", "expected": 0 },
            { "type": "simvar", "var": "(L:INI_PROBE_HEAT_COPILOT)", "expected": 0 },
            { "type": "simvar", "var": "(L:INI_PROBE_HEAT_STANDBY)", "expected": 0 }
          ]
        }
      ]
    },
    {
      "challenge": "parking_brake_and_chocks.ogg",
      "response": ["chocks in place", "parking brake on", "chocks in and brakes on", "set and checked"],
      "label": "Parking Brake and Chocks"
    }
  ],
  "completion": "parking_checklist_completed.ogg"
}
